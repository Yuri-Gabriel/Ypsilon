{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug C (Debian Linux)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/output/main",
            "args": ["samples/define_function.y"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "build",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": false
                }
            ]
        }
    ]
}